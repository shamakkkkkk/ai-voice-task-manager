# ── Database ────────────────────────────────────────────────────────────────
# Default: a local SQLite file at ./data/tasks.db (created automatically).
# On Vercel use Turso (SQLite in the cloud), otherwise tasks vanish on every cold start:
#   DATABASE_URL=libsql://<your-db>.turso.io
#   DATABASE_AUTH_TOKEN=<token from `turso db tokens create <your-db>`>
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ── Understanding phrases (Classic mode) ───────────────────────────────────
# Works with NO keys (built-in RU/EN parser). Add one key to use an LLM instead.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── OpenAI: Live mode (Realtime API) and/or phrase understanding ───────────
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini            # phrase understanding in Classic mode
# OPENAI_REALTIME_MODEL=gpt-realtime-2
# OPENAI_REALTIME_VOICE=marin

# Force the Classic-mode engine: anthropic | openai | local
# AI_PROVIDER=

# Requests per minute per IP on /api/command
# RATE_LIMIT_PER_MIN=30
